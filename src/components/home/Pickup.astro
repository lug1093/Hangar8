---
import Icon from '../ui/Icon.astro';
---

<section aria-labelledby="retiro-title" class="border-y border-line bg-surface">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-4 px-4 py-8 md:flex-row md:items-center md:gap-6 md:px-6 md:py-10">
    <Icon name="truck" size={40} class="shrink-0 text-accent" />
    <div>
      <h2 id="retiro-title" class="display text-[32px] md:text-[40px]">Retiramos y entregamos a domicilio</h2>
      <p class="mt-2 max-w-[64ch] text-text-2">
        No hace falta que dejes el día para traer el auto. Coordinamos por WhatsApp, lo pasamos a buscar y te lo
        devolvemos listo.
      </p>
    </div>
  </div>
</section>
