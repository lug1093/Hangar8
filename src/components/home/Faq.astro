---
// <details> nativo: teclado, foco y estado expandido sin JavaScript.
import { faqs } from '../../data/site';
import Section from '../site/Section.astro';
import SectionHeading from '../site/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
---

<Section id="preguntas" labelledby="faq-title">
  <div class="grid gap-8 lg:grid-cols-[1fr_1.4fr] lg:gap-12">
    <SectionHeading flush id="faq-title" eyebrow="Preguntas frecuentes" title="Lo que más nos preguntan" />
    <div class="divide-y divide-line border-y border-line">
      {
        faqs.map((f) => (
          <details class="group">
            <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-4 text-lg font-medium leading-7 [&::-webkit-details-marker]:hidden">
              {f.q}
              <Icon name="chevron-down" size={20} class="shrink-0 transition-transform duration-[200ms] group-open:rotate-180" />
            </summary>
            <p class="max-w-[64ch] pb-5 text-text-2">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</Section>
