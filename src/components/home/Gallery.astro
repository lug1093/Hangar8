---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { SHOW_PLACEHOLDERS } from '../../config/flags';
import { business, gallery } from '../../data/site';
import Section from '../site/Section.astro';
import SectionHeading from '../site/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

// Cargar una foto es dejarla en src/assets/trabajos/ y nombrarla en `gallery`.
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/trabajos/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const byName = new Map(Object.entries(files).map(([p, m]) => [p.split('/').pop()!, m.default]));

const items = gallery.map((g) => {
  if (!g.src) return { ...g, image: null };
  const image = byName.get(g.src);
  if (!image) throw new Error(`Galería: no existe src/assets/trabajos/${g.src}`);
  if (!g.alt.trim()) throw new Error(`Galería: falta el texto alternativo de ${g.src}`);
  return { ...g, image };
});
const visible = items.filter((g) => g.image || SHOW_PLACEHOLDERS);
const instagram = business.social.find((s) => s.label === 'Instagram');
---

{
  visible.length > 0 && (
    <Section id="trabajos" labelledby="trabajos-title">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <SectionHeading id="trabajos-title" eyebrow="Trabajos" title="Así quedan los autos" />
        {instagram && (
          <Button href={instagram.href} external variant="secondary" class="mb-6 self-start md:mb-8 md:self-auto">
            Más trabajos en Instagram <Icon name="arrow-right" size={16} />
          </Button>
        )}
      </div>
      <ul data-align-group="galería" class="grid grid-cols-2 gap-2 md:grid-cols-3 md:gap-3">
        {visible.map((g) => (
          <li>
            <figure data-align="bottom" class="flex h-full flex-col overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface">
              {g.image ? (
                <Picture
                  src={g.image}
                  alt={g.alt}
                  formats={['avif', 'webp']}
                  widths={[400, 800]}
                  sizes="(min-width: 768px) 33vw, 50vw"
                  loading="lazy"
                  decoding="async"
                  class="block aspect-[4/3] w-full object-cover"
                />
              ) : (
                <div class="flex aspect-[4/3] flex-col items-center justify-center gap-2 border-b border-dashed border-edge text-text-2">
                  <Icon name="camera" size={28} />
                  <span class="text-xs font-medium uppercase tracking-wider">Foto pendiente</span>
                </div>
              )}
              <figcaption class="flex-1 px-3 py-2.5 text-sm">{g.caption}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </Section>
  )
}
