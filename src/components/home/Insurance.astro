---
import { business, insurance } from '../../data/site';
import { path } from '../../lib/path';
import InsurerLogos from '../site/InsurerLogos.astro';
import Section from '../site/Section.astro';
import SectionHeading from '../site/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

const points = [
  'Trabajamos con todas las compañías de seguro',
  'Coordinamos con tu compañía por vos',
  'Te avisamos cuando el auto está listo',
];
---

<Section id="seguros" tone="ink" labelledby="seguros-title">
  <div class="grid items-start gap-8 lg:grid-cols-[1.2fr_1fr] lg:gap-12">
    <SectionHeading
      id="seguros-title"
      tone="ink"
      flush
      eyebrow="Seguros"
      title="¿Tuviste un choque? Lo resolvemos con tu seguro"
      lead="Escribinos con la patente, la compañía y el número de siniestro si ya lo tenés. Nos ocupamos del resto del trámite con la aseguradora."
    />
    <div class="rounded-[var(--radius-card)] border border-ink-line bg-ink-2 p-6 md:p-8">
      <ul class="space-y-4">
        {
          points.map((p) => (
            <li class="flex gap-3">
              <Icon name="check" size={22} class="mt-0.5 shrink-0 text-ink-accent" />
              <span>{p}</span>
            </li>
          ))
        }
      </ul>
      <Button
        href={business.whatsappHref(insurance.whatsappText)}
        external
        variant="secondary-ink"
        class="mt-8 w-full"
      >
        <Icon name="message-circle" size={18} />Consultar por mi siniestro
      </Button>
      <a href={path('/seguros/')} class="mt-4 inline-flex min-h-[44px] w-full items-center justify-center gap-1.5 text-[15px] font-medium text-on-ink underline-offset-4 hover:underline">
        Cómo es el trámite con el seguro <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </div>

  <InsurerLogos tone="ink" class="mt-8" />
</Section>
