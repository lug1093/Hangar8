---
import { business } from '../../data/site';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  title?: string;
  whatsappText?: string;
}
const { title = 'Mandanos fotos y te pasamos el presupuesto', whatsappText } = Astro.props;
---

<section aria-labelledby="cta-title" class="bg-ink text-on-ink">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-6 px-4 py-12 md:flex-row md:items-center md:justify-between md:px-6 lg:py-16">
    <div>
      <h2 id="cta-title" class="display max-w-[24ch] text-[40px] md:text-[52px]">{title}</h2>
      <p class="mt-3 text-on-ink-2">{business.hours.label} · {business.address.street}, {business.address.city}</p>
    </div>
    <Button href={business.whatsappHref(whatsappText)} external size="lg" class="shrink-0">
      <Icon name="message-circle" size={20} />Escribir por WhatsApp
    </Button>
  </div>
</section>
