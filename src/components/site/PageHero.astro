---
// Cabecera de las páginas internas (servicios, seguros): ruta, título y las dos
// acciones. La portada tiene su propio Hero.
import { business } from '../../data/site';
import { path } from '../../lib/path';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Crumb {
  label: string;
  href: string;
}

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  whatsappText: string;
  /** Tramos intermedios de la ruta, entre Inicio y la página actual. */
  crumbs?: Crumb[];
}

const { eyebrow, title, intro, whatsappText, crumbs = [] } = Astro.props;
const linkClass = 'inline-flex min-h-[32px] items-center underline-offset-4 hover:underline';
---

<section aria-labelledby="page-title" class="bg-ink text-on-ink">
  <div class="mx-auto max-w-[1200px] px-4 pb-10 pt-6 md:px-6 md:pb-12 md:pt-8">
    <nav aria-label="Ruta" class="mb-6 text-sm text-on-ink-2">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href={path('/')} class={linkClass}>Inicio</a></li>
        {
          crumbs.map((c) => (
            <>
              <li aria-hidden="true">/</li>
              <li><a href={path(c.href)} class={linkClass}>{c.label}</a></li>
            </>
          ))
        }
        <li aria-hidden="true">/</li>
        <li><span aria-current="page" class="font-medium text-on-ink">{title}</span></li>
      </ol>
    </nav>
    <p class="mb-4 text-sm font-medium uppercase tracking-[0.14em] text-ink-accent">{eyebrow}</p>
    <h1 id="page-title" class="display text-[52px] md:text-[80px]">{title}</h1>
    <p class="mt-5 max-w-[60ch] text-lg leading-7 text-on-ink-2">{intro}</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row" data-hero-cta>
      <Button href={business.whatsappHref(whatsappText)} external size="lg">
        <Icon name="message-circle" size={20} />Pedir presupuesto por WhatsApp
      </Button>
      <Button href={business.phoneHref} variant="secondary-ink" size="lg">
        <Icon name="phone" size={20} />Llamar al {business.phoneDisplay}
      </Button>
    </div>
  </div>
</section>
