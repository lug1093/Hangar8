---
import { steps } from '../../data/site';
---

<ol class="grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-line bg-line md:grid-cols-3">
  {
    steps.map((step, i) => (
      <li class="bg-bg p-5 md:p-6">
        <span class="display block text-[52px] leading-none text-accent" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <h3 class="mt-3 text-xl font-medium leading-7">
          <span class="sr-only">Paso {i + 1}: </span>
          {step.title}
        </h3>
        <p class="mt-2 text-text-2">{step.body}</p>
      </li>
    ))
  }
</ol>
