---
import { path } from '../lib/path';
import '../styles/global.css';
// Solo los dos archivos que usa la primera pantalla (latin): precargarlos evita
// el salto de layout cuando llegan las fuentes (Lighthouse, CLS; ver D-15).
import displayFont from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import sansFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { areas, business } from '../data/site';
import Footer from '../components/site/Footer.astro';
import Header from '../components/site/Header.astro';
import MobileBar from '../components/site/MobileBar.astro';

interface Props {
  title: string;
  description: string;
  whatsappText?: string;
  /** Datos estructurados propios de la página (FAQPage, Service, BreadcrumbList). */
  schema?: Record<string, unknown>[];
  /** Imagen para compartir, generada con `npm run og` en public/og/. */
  ogImage?: string;
}

const { title, description, whatsappText, schema = [], ogImage = 'inicio' } = Astro.props;
const ogImageUrl = new URL(path(`/og/${ogImage}.png`), Astro.site).toString();
const canonical = new URL(Astro.url.pathname, Astro.site);
// La vista previa no se indexa: tiene placeholders y duplicaría el sitio real.
const noindex = import.meta.env.PUBLIC_PREVIEW === 'true';

// Datos estructurados de negocio local: es lo que Google usa para el panel del mapa.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoBodyShop',
  '@id': new URL(path('/#taller'), Astro.site).toString(),
  name: business.name,
  description: business.description,
  telephone: business.phoneHref.replace('tel:', ''),
  url: Astro.site?.toString(),
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.city,
    addressRegion: business.address.region,
    addressCountry: business.address.country,
  },
  openingHours: business.hours.schema,
  hasMap: business.mapsHref,
  sameAs: business.social.map((s) => s.href),
  image: ogImageUrl,
  logo: new URL(path('/apple-touch-icon.png'), Astro.site).toString(),
  areaServed: areas.map((name) => ({ '@type': 'City', name })),
  priceRange: '$$',
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={path('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={path('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#0e0f11" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${business.name}, ${business.tagline.toLowerCase()} en ${business.address.city}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {schema.map((item) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...item })} />)}
    <!-- Vercel Speed Insights -->
    <script>
      window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };
    </script>
    <script defer src="/_vercel/speed-insights/script.js"></script>
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-[var(--radius-btn)] focus:bg-bg focus:px-4 focus:py-3 focus:text-text"
    >
      Ir al contenido
    </a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <MobileBar whatsappText={whatsappText} />
  </body>
</html>
