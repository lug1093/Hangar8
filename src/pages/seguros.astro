---
import CtaBand from '../components/site/CtaBand.astro';
import Faq from '../components/site/Faq.astro';
import InsurerLogos from '../components/site/InsurerLogos.astro';
import PageHero from '../components/site/PageHero.astro';
import Section from '../components/site/Section.astro';
import SectionHeading from '../components/site/SectionHeading.astro';
import Steps from '../components/site/Steps.astro';
import Icon from '../components/ui/Icon.astro';
import { areas, business, insurance } from '../data/site';
import { path } from '../lib/path';
import Base from '../layouts/Base.astro';

const url = new URL(path('/seguros/'), Astro.site).toString();

const schema = [
  {
    '@type': 'Service',
    name: 'Reparación de choques por seguro',
    serviceType: 'Reparación de carrocería por siniestro',
    description: insurance.intro,
    url,
    provider: { '@id': new URL(path('/#taller'), Astro.site).toString() },
    areaServed: areas.map((name) => ({ '@type': 'City', name })),
  },
  {
    '@type': 'FAQPage',
    mainEntity: insurance.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(path('/'), Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Seguros', item: url },
    ],
  },
];
---

<Base
  title="Reparación por seguro en Ituzaingó | Hangar 8"
  description={`Trabajamos con todas las compañías de seguro. Te acompañamos en el trámite del siniestro y reparamos tu auto en ${business.address.street}, ${business.address.city}.`}
  whatsappText={insurance.whatsappText}
  schema={schema}
  ogImage="seguros"
>
  <PageHero
    eyebrow="Trabajamos con todas las compañías"
    title="Reparación por seguro"
    intro={insurance.intro}
    whatsappText={insurance.whatsappText}
  />

  <Section labelledby="datos-title">
    <div class="grid gap-8 lg:grid-cols-[1fr_1.4fr] lg:gap-12">
      <SectionHeading
        flush
        id="datos-title"
        eyebrow="Antes de escribirnos"
        title="Qué tener a mano"
        lead="Con esto armamos el presupuesto para la compañía. Si te falta algo, escribinos igual y lo vemos juntos."
      />
      <ul class="divide-y divide-line border-y border-line">
        {
          insurance.checklist.map((item) => (
            <li class="flex gap-3 py-4 text-lg">
              <Icon name="check" size={22} class="mt-0.5 shrink-0 text-accent" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section tone="surface" labelledby="tramite-title">
    <SectionHeading id="tramite-title" eyebrow="El trámite" title="Cómo es una reparación por seguro" />
    <Steps items={insurance.steps} />
    <InsurerLogos class="mt-8" />
  </Section>

  <Faq items={insurance.faqs} title="Dudas sobre el seguro" />

  <CtaBand title="Mandanos los datos del siniestro" whatsappText={insurance.whatsappText} />
</Base>
