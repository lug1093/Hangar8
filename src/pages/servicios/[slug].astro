---
import CtaBand from '../../components/site/CtaBand.astro';
import Section from '../../components/site/Section.astro';
import SectionHeading from '../../components/site/SectionHeading.astro';
import ServiceGrid from '../../components/site/ServiceGrid.astro';
import Steps from '../../components/site/Steps.astro';
import PageHero from '../../components/site/PageHero.astro';
import Icon from '../../components/ui/Icon.astro';
import { areas, business, services, type Service } from '../../data/site';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: Service;
}
const { service } = Astro.props;
const url = new URL(`/servicios/${service.slug}/`, Astro.site).toString();

const schema = [
  {
    '@type': 'Service',
    name: service.name,
    serviceType: service.name,
    description: service.intro,
    url,
    provider: { '@id': new URL('/#taller', Astro.site).toString() },
    areaServed: areas.map((name) => ({ '@type': 'City', name })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Servicios', item: new URL('/#servicios', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: service.name, item: url },
    ],
  },
];
---

<Base
  title={`${service.name} en Ituzaingó | Hangar 8`}
  description={`${service.intro.split('. ')[0]}. ${business.name}, ${business.address.street}, ${business.address.city}.`}
  whatsappText={service.whatsappText}
  schema={schema}
>
  <PageHero
    eyebrow={`Servicio en ${business.address.city}`}
    title={service.name}
    intro={service.intro}
    whatsappText={service.whatsappText}
    crumbs={[{ label: 'Servicios', href: '/#servicios' }]}
  />

  <Section labelledby="incluye-title">
    <div class="grid gap-8 lg:grid-cols-[1fr_1.4fr] lg:gap-12">
      <SectionHeading flush id="incluye-title" eyebrow="Qué incluye" title={`${service.name}: qué hacemos`} />
      <ul class="divide-y divide-line border-y border-line">
        {
          service.includes.map((item) => (
            <li class="flex gap-3 py-4 text-lg">
              <Icon name="check" size={22} class="mt-0.5 shrink-0 text-accent" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section tone="surface" labelledby="pasos-title">
    <SectionHeading id="pasos-title" eyebrow="Cómo trabajamos" title="Tres pasos y tu auto está listo" />
    <Steps />
    <p class="mt-6 flex items-center gap-2 text-text-2">
      <Icon name="shield-check" size={20} class="text-accent" />
      Trabajamos con todas las compañías de seguro y retiramos y entregamos a domicilio.
    </p>
  </Section>

  <Section labelledby="otros-title">
    <SectionHeading id="otros-title" eyebrow="Otros servicios" title="También hacemos" />
    <ServiceGrid exclude={service.slug} />
  </Section>

  <CtaBand whatsappText={service.whatsappText} />
</Base>
