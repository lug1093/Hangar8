---
import { path } from '../lib/path';
import Button from '../components/ui/Button.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada | Hangar 8" description="La página que buscás no existe.">
  <section class="mx-auto max-w-[1200px] px-4 py-16 md:px-6">
    <h1 class="display text-[56px]">Esta página no existe</h1>
    <p class="mt-4 text-lg text-text-2">Puede que el link esté mal escrito o que la página se haya movido.</p>
    <Button href={path('/')} variant="secondary" class="mt-8">Volver al inicio</Button>
  </section>
</Base>
